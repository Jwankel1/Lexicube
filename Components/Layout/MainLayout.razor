@inherits LayoutComponentBase

<div class="backdrop" aria-hidden="true"></div>

<header class="topbar">
    <a class="brand" href="/" aria-label="Lexicube home">
        <span class="brand-cubes">
            @foreach (var (ch, i) in "LEXI".Select((c, i) => (c, i)))
            {
                <b style="--i:@i">@ch</b>
            }
        </span><span class="brand-rest">CUBE</span>
    </a>
    <AuthorizeView>
        <Authorized>
            <div class="who">
                <span class="who-name">@context.User.Identity?.Name</span>
                <form method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <button class="link-btn" type="submit">Sign out</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
</div>
